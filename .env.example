# Copy to .env and edit; .env is private and ignored by Git.
# Literal values only: no shell commands or variable interpolation.
# Priority: CLI > existing process environment > .env > built-in defaults.

# Disk image: size is applied only when creating a new disk.
DISK=disk.img
DISK_MB=4096
DATA_DISK=

# QEMU
QEMU_MEM=256M
QEMU_CPUS=4
QEMU_CPU=max
VGA=auto
GPU=auto
HOST_PORT=8081
SSH_PORT=2222

# BIOS Live image: 64..512 MiB. Recommended RAM: 512 MiB for a 256 MiB root.
USB_ROOT_MB=256
USB_VIDEO=auto

# HTTP netboot server and one-time iPXE USB bootstrap.
NETBOOT_BIND=0.0.0.0
NETBOOT_PORT=8080
# Set the LAN IP of the computer running the HTTP server.
NETBOOT_URL=http://192.168.1.10:8080/boot.ipxe
NETBOOT_DIRECTORY=build/netboot
NETBOOT_IMAGE=build/myos-usb.img
NETBOOT_MANIFEST=build/hardware/manifest.json
IPXE_JOBS=4

# Optional toolchain overrides; CROSS defaults to i686-elf- on macOS.
# CROSS=
# CC=gcc
# LD=ld
# AR=ar
# NM=nm
# OBJCOPY=objcopy
# NASM=nasm
# QEMU=qemu-system-i386
# HOSTCC=cc

# Packages installed in the background on each fresh Live boot. Empty disables it.
# Example: EXT_AUTOINSTALL_PACKAGES="openssh lua"
EXT_AUTOINSTALL_PACKAGES=""

# Public Ed25519 keys authorized to SSH as root in built images. Never use a private key.
SSH_AUTHORIZED_KEY=""
# Optional public-key file (one or more keys). Relative paths start at the project root.
# WSL example: /mnt/c/Users/yourname/.ssh/id_ed25519.pub
SSH_AUTHORIZED_KEY_FILE=""

# Guest EXT build parallelism: auto uses online CPUs and free RAM; 1 forces serial builds.
# Accepted values: auto or 1..16. Seeds /etc/ext/build-jobs on fresh images.
EXT_BUILD_JOBS=auto
